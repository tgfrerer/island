#ifndef GUARD_@module_name@_H
#define GUARD_@module_name@_H

#include "le_core.h"

struct @module_name@_o;

struct @module_name@_api {

	struct @module_name@_interface_t {

		@module_name@_o *    ( * create                   ) ( );
		@module_name@_o *    ( * clone                    ) ( @module_name@_o* rhs);
		void                 ( * destroy                  ) ( @module_name@_o* self );

		void                 ( * update                   ) ( @module_name@_o* self );

	};

	@module_name@_interface_t       @module_name@_i;
};

LE_MODULE( @module_name@ );
LE_MODULE_LOAD_DEFAULT( @module_name@ );

#ifdef __cplusplus

namespace @module_name@ {
	static const auto &api = @module_name@_api_i;
	static const auto &@module_name@_i = api->@module_name@_i;
} // namespace

class @module_name_camelcase_capitalised@ {

	@module_name@_o *self = nullptr;

  public:

	// --- SCAFFOLDING ------------------------------------------------------

	operator @module_name@_o* ()  { return self; }
	operator const @module_name@_o* () const { return self; }

	@module_name_camelcase_capitalised@()
	    : self( @module_name@::@module_name@_i.create() ) {
	}

	// Destructor
	~@module_name_camelcase_capitalised@() {
		if( self ){
			@module_name@::@module_name@_i.destroy( self );
		}
	}

	// Move constructor 
	@module_name_camelcase_capitalised@(@module_name_camelcase_capitalised@&& rhs)
		:self( rhs.self ) {
			// note that this may leave an empty shell in place of rhs
			rhs.self = nullptr;
	}

	// Move assignment
	@module_name_camelcase_capitalised@& operator=(@module_name_camelcase_capitalised@&& rhs){
		if( this->self ){
			@module_name@::@module_name@_i.destroy( this->self );
		}
		this->self = rhs.self;
		rhs.self   = nullptr;
		return *this;
	}

	// Copy constructor 
	@module_name_camelcase_capitalised@(@module_name_camelcase_capitalised@ const & rhs)
		:self( @module_name@::@module_name@_i.clone( rhs.self )) {
	}

	// Copy assignment
	@module_name_camelcase_capitalised@& operator=(@module_name_camelcase_capitalised@ const & rhs){
		if( this->self ){
			@module_name@::@module_name@_i.destroy( this->self );
		}
		this->self = @module_name@::@module_name@_i.clone( rhs.self );
		return *this;
	}


	// --- USER-DEFINED METHODS ---------------------------------------------

	void update() {
		@module_name@::@module_name@_i.update( self );
	}


};

#endif // __cplusplus

